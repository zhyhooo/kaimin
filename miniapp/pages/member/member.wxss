.page { background: #f5f5f5; min-height: 100vh; }
.search-bar { padding: 20rpx; background: #fff; }
.search-input { background: #f5f5f5; border-radius: 32rpx; padding: 14rpx 30rpx; font-size: 28rpx; }
.branch-tabs { white-space: nowrap; padding: 16rpx 0; background: #fff; border-bottom: 1rpx solid #f0f0f0; }
.branch-tab { display: inline-flex; align-items: center; gap: 8rpx; padding: 12rpx 24rpx; font-size: 26rpx; color: #666; margin-left: 16rpx; border-radius: 20rpx; background: #f5f5f5; }
.branch-tab.active { background: #C41E2E; color: #fff; }
.tab-count { font-size: 22rpx; opacity: 0.7; }
.branch-tab.active .tab-count { color: rgba(255,255,255,0.8); }
.member-list { background: #fff; margin-top: 20rpx; }
.member-item { display: flex; align-items: center; padding: 24rpx; border-bottom: 1rpx solid #f5f5f5; }
.member-item:last-child { border: none; }
.avatar { width: 80rpx; height: 80rpx; border-radius: 50%; }
.info { flex: 1; margin-left: 20rpx; }
.name { font-size: 30rpx; color: #333; display: block; }
.branch { font-size: 24rpx; color: #999; margin-top: 6rpx; display: block; }
.arrow { font-size: 32rpx; color: #ccc; }
.empty { text-align: center; color: #999; font-size: 28rpx; padding: 120rpx 0; }