.page { background: #f5f5f5; min-height: 100vh; }
.profile-card { background: linear-gradient(135deg, #C41E2E, #e8485a); padding: 50rpx 30rpx 40rpx; text-align: center; }
.avatar { width: 120rpx; height: 120rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,0.5); display: block; margin: 0 auto 16rpx; }
.name { font-size: 36rpx; font-weight: bold; color: #fff; display: block; }
.role { font-size: 26rpx; color: rgba(255,255,255,0.85); margin-top: 8rpx; display: block; }
.sub-info { font-size: 22rpx; color: rgba(255,255,255,0.65); margin-top: 6rpx; display: block; }
.info-section { background: #fff; margin: 20rpx; border-radius: 12rpx; overflow: hidden; }
.info-row { display: flex; padding: 26rpx 24rpx; border-bottom: 1rpx solid #f5f5f5; }
.info-row:last-child { border: none; }
.label { font-size: 28rpx; color: #999; width: 160rpx; flex-shrink: 0; }
.value { font-size: 28rpx; color: #333; flex: 1; }