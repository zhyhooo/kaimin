<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索姓名或单位" value="{{keyword}}" bindinput="onSearch" confirm-type="search"/>
  </view>
  <!-- 支部选项卡 -->
  <scroll-view scroll-x class="branch-tabs" wx:if="{{branches.length > 0}}">
    <view class="branch-tab {{activeBranchId === item.id ? 'active' : ''}}"
          wx:for="{{branches}}" wx:key="id"
          bindtap="onTabTap" data-id="{{item.id}}">
      <text>{{item.name}}</text>
      <text class="tab-count" wx:if="{{item.member_count !== undefined}}">{{item.member_count}}人</text>
    </view>
  </scroll-view>
  <!-- 会员列表 -->
  <view class="member-list">
    <view class="member-item" wx:for="{{members}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <image class="avatar" src="{{item.avatar || '/assets/default-avatar.png'}}" mode="aspectFill"/>
      <view class="info">
        <text class="name">{{item.name}}</text>
        <text class="branch">{{item.branch_name || item.org_position || item.work_unit || ''}}</text>
      </view>
      <text class="arrow">→</text>
    </view>
  </view>
  <view class="empty" wx:if="{{members.length === 0}}">暂无成员</view>
</view>