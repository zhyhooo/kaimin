.page { background: #f5f5f5; min-height: 100vh; }
.search-bar { padding: 20rpx; background: #fff; }
.search-input { background: #f5f5f5; border-radius: 32rpx; padding: 14rpx 30rpx; font-size: 28rpx; }
.material-list { background: #fff; margin-top: 20rpx; }
.material-item { display: flex; align-items: center; padding: 24rpx; border-bottom: 1rpx solid #f5f5f5; }
.material-item:last-child { border: none; }
.m-icon { font-size: 40rpx; width: 60rpx; text-align: center; flex-shrink: 0; }
.m-info { flex: 1; margin-left: 10rpx; }
.m-title { font-size: 28rpx; color: #333; display: block; }
.m-category { font-size: 22rpx; color: #C41E2E; background: #fde8ea; padding: 2rpx 12rpx; border-radius: 10rpx; display: inline-block; margin-top: 6rpx; }
.m-time { font-size: 22rpx; color: #999; display: block; margin-top: 6rpx; }
.empty { text-align: center; color: #999; font-size: 28rpx; padding: 120rpx 0; }