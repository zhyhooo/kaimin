.page { background: #f5f5f5; min-height: 100vh; padding-bottom: 40rpx; }
.cover { width: 100%; height: 360rpx; }
.header { background: #fff; padding: 30rpx 24rpx; margin-bottom: 20rpx; }
.title { font-size: 36rpx; font-weight: bold; color: #333; display: block; line-height: 1.4; }
.meta { display: flex; align-items: center; margin-top: 14rpx; }
.meta-tag { font-size: 24rpx; color: #999; background: #f5f5f5; padding: 4rpx 16rpx; border-radius: 8rpx; }
.meta-required { font-size: 24rpx; color: #C41E2E; background: #FFF0F0; padding: 4rpx 16rpx; border-radius: 8rpx; margin-left: 12rpx; }
.body { background: #fff; padding: 24rpx; margin-bottom: 20rpx; line-height: 1.8; font-size: 28rpx; color: #333; }
.file-area { background: #fff; margin: 0 0 20rpx; padding: 24rpx; }
.file-tip { font-size: 26rpx; color: #666; display: block; }
.file-link { font-size: 24rpx; color: #C41E2E; display: block; margin-top: 8rpx; word-break: break-all; }
.tags { background: #fff; padding: 20rpx 24rpx; margin-bottom: 20rpx; display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag { font-size: 22rpx; color: #666; background: #f0f0f0; padding: 6rpx 16rpx; border-radius: 20rpx; }
.footer { text-align: center; padding: 20rpx; }
.view-count { font-size: 24rpx; color: #bbb; }