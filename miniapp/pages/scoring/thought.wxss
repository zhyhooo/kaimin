.page { background: #f5f5f5; min-height: 100vh; }
.header-tip { background: #fff; padding: 30rpx 24rpx; margin-bottom: 20rpx; text-align: center; }
.header-tip text { display: block; font-size: 32rpx; font-weight: bold; color: #333; }
.hint { font-size: 24rpx !important; color: #C41E2E !important; font-weight: normal !important; margin-top: 10rpx; }
.form-section { background: #fff; margin: 0 20rpx; border-radius: 12rpx; padding: 24rpx; }
.form-item { margin-bottom: 20rpx; }
.label { font-size: 28rpx; color: #333; display: block; margin-bottom: 14rpx; font-weight: bold; }
.textarea { width: 100%; min-height: 400rpx; background: #f9f9f9; border-radius: 8rpx; padding: 20rpx; font-size: 28rpx; color: #333; box-sizing: border-box; }
.submit-area { padding: 30rpx 20rpx; }
.btn-submit { background: #C41E2E; color: #fff; border-radius: 40rpx; font-size: 32rpx; }