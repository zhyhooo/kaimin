.page { background: #f5f5f5; min-height: 100vh; }
.score-board { background: linear-gradient(135deg, #C41E2E, #e8485a); padding: 40rpx 30rpx; text-align: center; }
.total-score { margin-bottom: 16rpx; }
.num { font-size: 72rpx; font-weight: bold; color: #fff; }
.unit { font-size: 28rpx; color: rgba(255,255,255,0.8); margin-left: 8rpx; }
.progress { width: 80%; margin: 10rpx auto; }
.progress-text { font-size: 22rpx; color: rgba(255,255,255,0.7); display: block; margin-bottom: 20rpx; }
/* 六维条 */
.dim-list { margin-top: 20rpx; padding: 0 10rpx; }
.dim-item { display: flex; align-items: center; padding: 10rpx 0; }
.dim-label { width: 130rpx; font-size: 24rpx; color: rgba(255,255,255,0.9); text-align: right; margin-right: 12rpx; flex-shrink: 0; }
.dim-bar-bg { flex: 1; height: 16rpx; background: rgba(255,255,255,0.25); border-radius: 8rpx; overflow: hidden; }
.dim-bar-fill { height: 100%; background: #FFD700; border-radius: 8rpx; transition: width 0.5s; }
.dim-bar-fill.reached { background: #4CAF50; }
.dim-val { width: 90rpx; font-size: 22rpx; color: rgba(255,255,255,0.9); text-align: center; flex-shrink: 0; }
.dim-check { width: 30rpx; font-size: 22rpx; color: #4CAF50; text-align: center; }
.section { background: #fff; margin: 20rpx; border-radius: 12rpx; padding: 24rpx; }
.section-header { margin-bottom: 16rpx; }
.title { font-size: 32rpx; font-weight: bold; color: #333; }
.task-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.task-item:last-child { border: none; }
.task-info { flex: 1; }
.t-name { font-size: 28rpx; color: #333; display: block; }
.t-desc { font-size: 24rpx; color: #999; margin-top: 4rpx; display: block; }
.t-progress { font-size: 26rpx; font-weight: bold; color: #C41E2E; }
.empty { text-align: center; color: #999; font-size: 28rpx; padding: 40rpx 0; }
.btn-area { padding: 20rpx; display: flex; gap: 20rpx; }
.btn-records { flex: 1; background: #fff; color: #C41E2E; border: 2rpx solid #C41E2E; border-radius: 40rpx; font-size: 30rpx; }
.btn-thought { flex: 1; background: #C41E2E; color: #fff; border-radius: 40rpx; font-size: 30rpx; }