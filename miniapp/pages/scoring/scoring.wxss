.page { background: #f5f5f5; min-height: 100vh; }
.score-board { background: linear-gradient(135deg, #C41E2E, #e8485a); padding: 40rpx 30rpx; text-align: center; }
.total-score { margin-bottom: 24rpx; }
.num { font-size: 72rpx; font-weight: bold; color: #fff; }
.unit { font-size: 28rpx; color: rgba(255,255,255,0.8); margin-left: 8rpx; }
.score-detail { display: flex; justify-content: space-around; }
.score-detail .item { display: flex; flex-direction: column; align-items: center; }
.score-detail .val { font-size: 32rpx; font-weight: bold; color: #fff; }
.score-detail .lbl { font-size: 22rpx; color: rgba(255,255,255,0.75); margin-top: 4rpx; }
.section { background: #fff; margin: 20rpx; border-radius: 12rpx; padding: 24rpx; }
.section-header { margin-bottom: 16rpx; }
.title { font-size: 32rpx; font-weight: bold; color: #333; }
.task-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.task-item:last-child { border: none; }
.task-info { flex: 1; }
.t-name { font-size: 28rpx; color: #333; display: block; }
.t-desc { font-size: 24rpx; color: #999; margin-top: 4rpx; display: block; }
.t-score { font-size: 30rpx; font-weight: bold; color: #C41E2E; }
.empty { text-align: center; color: #999; font-size: 26rpx; padding: 30rpx 0; }
.btn-area { padding: 0 20rpx; }
.btn-records { background: #fff; color: #C41E2E; border: 2rpx solid #C41E2E; border-radius: 40rpx; font-size: 30rpx; }