<view class="page">
  <view class="score-board" wx:if="{{board}}">
    <view class="total-score">
      <text class="num">{{board.total_score || 0}}</text>
      <text class="unit">/ {{board.target_score || 90}} 分</text>
    </view>
    <progress class="progress" percent="{{board.progress_pct || 0}}" stroke-width="8" activeColor="#C41E2E" backgroundColor="#eee"/>
    <text class="progress-text">积分进度 {{board.progress_pct || 0}}%</text>
    <!-- 六维条 -->
    <view class="dim-list">
      <view class="dim-item" wx:for="{{dimensions}}" wx:key="key">
        <text class="dim-label">{{item.label}}</text>
        <view class="dim-bar-bg">
          <view class="dim-bar-fill {{item.is_reached ? 'reached' : ''}}" style="width: {{item.max_score > 0 ? item.score / item.max_score * 100 : 0}}%"></view>
        </view>
        <text class="dim-val">{{item.score}}/{{item.max_score}}</text>
        <text class="dim-check" wx:if="{{item.is_reached}}">✓</text>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{tasks.length > 0}}">
    <view class="section-header">
      <text class="title">积分任务</text>
    </view>
    <view class="task-item" wx:for="{{tasks}}" wx:key="dimension">
      <view class="task-info">
        <text class="t-name">{{item.dimension}}</text>
        <text class="t-desc">{{item.suggestion}}</text>
      </view>
      <view class="t-progress">{{item.current}}/{{item.max}}</view>
    </view>
  </view>

  <view class="section" wx:if="{{tasks.length === 0 && board}}">
    <view class="empty">🎉 各项积分均已达标</view>
  </view>

  <view class="btn-area">
    <button class="btn-records" bindtap="goRecords">查看积分记录</button>
    <button class="btn-thought" bindtap="goThought">提交思想汇报</button>
  </view>
</view>