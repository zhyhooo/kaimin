<view class="page">
  <!-- 月切换 -->
  <view class="month-bar">
    <view class="btn-prev" bindtap="prevMonth">◀</view>
    <text class="month-label">{{year}}年{{month}}月</text>
    <view class="btn-next" bindtap="nextMonth">▶</view>
  </view>
  <!-- 星期头 -->
  <view class="week-header">
    <text wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this" class="week-day">{{item}}</text>
  </view>
  <!-- 日历格 -->
  <view class="calendar-grid">
    <view class="day-cell {{item.type}}" 
          wx:for="{{days}}" wx:key="index" 
          bindtap="onDateTap" data-date="{{item.date}}"
          data-type="{{item.type}}">
      <text class="day-num">{{item.day}}</text>
      <view class="day-dot" wx:if="{{eventMap[item.date] && eventMap[item.date].length}}"></view>
    </view>
  </view>
  <!-- 选中日期的活动列表 -->
  <view class="date-events" wx:if="{{dateEvents.length > 0}}">
    <text class="section-title">{{selectedDate}} 的活动</text>
    <view class="e-item" wx:for="{{dateEvents}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <text class="e-title">{{item.title}}</text>
      <text class="e-location">{{item.location}}</text>
    </view>
  </view>
  <view class="empty-date" wx:if="{{selectedDate && dateEvents.length === 0}}">
    {{selectedDate}} 暂无活动
  </view>
</view>