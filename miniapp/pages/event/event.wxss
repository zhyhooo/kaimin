.page { padding: 20rpx; background: #f5f5f5; min-height: 100vh; }
.event-card { background: #fff; border-radius: 12rpx; overflow: hidden; margin-bottom: 20rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05); }
.cover { width: 100%; height: 280rpx; }
.info { padding: 20rpx 24rpx; }
.title { font-size: 32rpx; font-weight: bold; color: #333; display: block; }
.time, .location { font-size: 26rpx; color: #666; display: block; margin-top: 10rpx; }
.tags { display: flex; align-items: center; gap: 10rpx; margin-top: 12rpx; }
.tag { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 20rpx; display: inline-block; }
.tag.branch { background: #FFF0F0; color: #C41E2E; }
.tag.open { background: #e8f5e9; color: #2e7d32; }
.tag.closed { background: #fff3e0; color: #e65100; }
.empty { text-align: center; color: #999; font-size: 28rpx; padding: 120rpx 0; }
.calendar-entry { background: #fff; margin: 20rpx; border-radius: 12rpx; padding: 28rpx; text-align: center; font-size: 28rpx; color: #C41E2E; display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.cal-icon { font-size: 32rpx; }
