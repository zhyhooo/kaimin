<view class="page">
  <view class="event-card" wx:for="{{events}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
    <image class="cover" src="{{item.cover_image}}" mode="aspectFill" wx:if="{{item.cover_image}}"/>
    <view class="info">
      <text class="title">{{item.title}}</text>
      <text class="time">🕐 {{item.event_time}}</text>
      <text class="location">📍 {{item.location}}</text>
      <text class="status {{item.status}}">{{item.status === 'open' ? '报名中' : item.status === 'closed' ? '已截止' : '已结束'}}</text>
    </view>
  </view>
  <view class="empty" wx:if="{{events.length === 0}}">暂无活动</view>
</view>