.page { background: #f5f5f5; min-height: 100vh; }
.month-bar { display: flex; justify-content: space-between; align-items: center; background: #C41E2E; padding: 20rpx 40rpx; }
.btn-prev, .btn-next { color: #fff; font-size: 32rpx; padding: 10rpx 20rpx; }
.month-label { color: #fff; font-size: 34rpx; font-weight: bold; }
.week-header { display: flex; background: #fff; border-bottom: 1rpx solid #eee; }
.week-day { flex: 1; text-align: center; padding: 16rpx 0; font-size: 26rpx; color: #999; }
.calendar-grid { display: flex; flex-wrap: wrap; background: #fff; }
.day-cell { width: 14.28%; aspect-ratio: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; }
.day-cell.prev, .day-cell.next { opacity: 0.35; }
.day-num { font-size: 28rpx; color: #333; }
.day-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #C41E2E; margin-top: 4rpx; }
.date-events { background: #fff; margin: 20rpx; border-radius: 12rpx; padding: 24rpx; }
.section-title { font-size: 28rpx; font-weight: bold; color: #333; display: block; margin-bottom: 16rpx; }
.e-item { padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.e-item:last-child { border: none; }
.e-title { font-size: 28rpx; color: #333; display: block; }
.e-location { font-size: 24rpx; color: #999; margin-top: 6rpx; display: block; }
.empty-date { text-align: center; padding: 40rpx; font-size: 26rpx; color: #bbb; }