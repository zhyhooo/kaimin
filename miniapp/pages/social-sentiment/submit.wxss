.page { background: #f5f5f5; min-height: 100vh; padding-bottom: 40rpx; }
.form-section { background: #fff; margin: 20rpx; border-radius: 12rpx; overflow: hidden; }
.form-item { padding: 26rpx 24rpx; border-bottom: 1rpx solid #f5f5f5; }
.form-item:last-child { border: none; }
.label { font-size: 28rpx; color: #333; display: block; margin-bottom: 12rpx; }
.input { font-size: 28rpx; color: #333; width: 100%; }
.textarea { font-size: 28rpx; color: #333; width: 100%; min-height: 200rpx; }
.switch-item { display: flex; justify-content: space-between; align-items: center; }
.switch-item .label { margin-bottom: 0; }
.btn-submit { background: #C41E2E; color: #fff; border-radius: 40rpx; margin: 40rpx 20rpx; font-size: 32rpx; }