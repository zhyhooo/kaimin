.page { background: #f5f5f5; min-height: 100vh; padding: 20rpx; }
.header { background: #fff; padding: 30rpx 24rpx; border-radius: 12rpx; margin-bottom: 20rpx; }
.title { font-size: 34rpx; font-weight: bold; color: #333; display: block; }
.meta { font-size: 24rpx; color: #999; margin-top: 12rpx; display: block; }
.body { background: #fff; padding: 24rpx; border-radius: 12rpx; margin-bottom: 20rpx; line-height: 1.8; font-size: 28rpx; color: #333; }
.attachments { background: #fff; padding: 24rpx; border-radius: 12rpx; }
.att-title { font-size: 28rpx; font-weight: bold; color: #333; display: block; margin-bottom: 16rpx; }
.att-item { font-size: 26rpx; color: #C41E2E; padding: 14rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.att-item:last-child { border: none; }