<view class="page">
  <view class="header-bar">
    <text class="title">消息中心</text>
    <text class="btn-all-read" bindtap="markAllRead">全部已读</text>
  </view>
  <view class="msg-list">
    <view class="msg-item {{item.is_read ? '' : 'unread'}}" wx:for="{{messages}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}" data-link="{{item.link}}">
      <view class="msg-dot" wx:if="{{!item.is_read}}"></view>
      <view class="msg-content">
        <text class="msg-title">{{item.title}}</text>
        <text class="msg-body" wx:if="{{item.content}}">{{item.content}}</text>
        <text class="msg-time">{{item.created_at}}</text>
      </view>
    </view>
  </view>
  <view class="empty" wx:if="{{messages.length === 0}}">暂无消息</view>
  <view class="load-more" wx:if="{{hasMore}}" bindtap="loadMore">加载更多</view>
</view>