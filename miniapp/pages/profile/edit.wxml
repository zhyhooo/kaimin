<view class="page">
  <view class="form-section">
    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input" placeholder="请输入手机号" value="{{form.phone}}" data-field="phone" bindinput="onFieldChange"/>
    </view>
    <view class="form-item">
      <text class="label">工作单位</text>
      <input class="input" placeholder="请输入工作单位" value="{{form.work_unit}}" data-field="work_unit" bindinput="onFieldChange"/>
    </view>
    <view class="form-item">
      <text class="label">职务</text>
      <input class="input" placeholder="请输入职务" value="{{form.work_position}}" data-field="work_position" bindinput="onFieldChange"/>
    </view>
    <view class="form-item">
      <text class="label">职称</text>
      <input class="input" placeholder="请输入职称" value="{{form.title}}" data-field="title" bindinput="onFieldChange"/>
    </view>
    <view class="form-item">
      <text class="label">学历</text>
      <input class="input" placeholder="请输入学历" value="{{form.education}}" data-field="education" bindinput="onFieldChange"/>
    </view>
    <view class="form-item">
      <text class="label">毕业院校</text>
      <input class="input" placeholder="请输入毕业院校" value="{{form.school}}" data-field="school" bindinput="onFieldChange"/>
    </view>
    <view class="form-item">
      <text class="label">专业</text>
      <input class="input" placeholder="请输入专业" value="{{form.specialty}}" data-field="specialty" bindinput="onFieldChange"/>
    </view>
    <view class="form-item">
      <text class="label">社会职务</text>
      <input class="input" placeholder="请输入社会职务" value="{{form.social_position}}" data-field="social_position" bindinput="onFieldChange"/>
    </view>
  </view>
  <view class="submit-area">
    <button class="btn-submit" bindtap="submit">提交修改</button>
  </view>
</view>