.page { background: #f5f5f5; min-height: 100vh; padding-bottom: 40rpx; }
.cover { width: 100%; height: 360rpx; }
.header { background: #fff; padding: 30rpx 24rpx; margin-bottom: 20rpx; }
.name { font-size: 36rpx; font-weight: bold; color: #333; display: block; }
.address { font-size: 26rpx; color: #666; margin-top: 12rpx; display: block; }
.desc { font-size: 26rpx; color: #999; margin-top: 10rpx; display: block; line-height: 1.5; }
.info-section { background: #fff; margin-bottom: 20rpx; padding: 0 24rpx; }
.info-row { display: flex; padding: 26rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.info-row:last-child { border: none; }
.label { font-size: 28rpx; color: #999; width: 160rpx; flex-shrink: 0; }
.value { font-size: 28rpx; color: #333; }
.btn-area { padding: 0 24rpx; }
.btn-book { background: #C41E2E; color: #fff; border-radius: 40rpx; font-size: 32rpx; }