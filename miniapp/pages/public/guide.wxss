.page { background: #f5f5f5; min-height: 100vh; }
.header { background: linear-gradient(135deg, #C41E2E, #e8485a); padding: 40rpx 30rpx; text-align: center; }
.title { font-size: 38rpx; font-weight: bold; color: #fff; display: block; }
.subtitle { font-size: 24rpx; color: rgba(255,255,255,0.6); display: block; margin-top: 8rpx; }
.section { background: #fff; margin: 20rpx; border-radius: 12rpx; padding: 24rpx; }
.section-title { font-size: 30rpx; font-weight: bold; color: #C41E2E; margin-bottom: 16rpx; padding-bottom: 12rpx; border-bottom: 2rpx solid #C41E2E; }
.condition-item { display: flex; align-items: flex-start; padding: 10rpx 0; font-size: 28rpx; color: #333; line-height: 1.7; }
.dot { color: #C41E2E; margin-right: 10rpx; font-weight: bold; }
.process-item { font-size: 28rpx; color: #333; padding: 12rpx 0; line-height: 1.7; border-bottom: 1rpx solid #f5f5f5; }
.process-item:last-child { border: none; }
.contact-item { display: flex; padding: 10rpx 0; }
.lbl { font-size: 26rpx; color: #999; width: 130rpx; flex-shrink: 0; }
.val { font-size: 28rpx; color: #333; }