.page { background: #f5f5f5; min-height: 100vh; }
.banner { width: 100%; height: 300rpx; }
.header { background: #fff; padding: 30rpx 24rpx; margin-bottom: 20rpx; }
.name { font-size: 36rpx; font-weight: bold; color: #333; display: block; }
.intro { font-size: 26rpx; color: #666; margin-top: 14rpx; display: block; line-height: 1.6; }
.info-section { background: #fff; margin-bottom: 20rpx; }
.info-row { display: flex; padding: 26rpx 24rpx; border-bottom: 1rpx solid #f5f5f5; }
.info-row:last-child { border: none; }
.label { font-size: 28rpx; color: #999; width: 100rpx; flex-shrink: 0; }
.value { font-size: 28rpx; color: #333; flex: 1; }
.content-section { background: #fff; padding: 24rpx; }