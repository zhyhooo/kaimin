<view class="page" wx:if="{{org}}">
  <view class="header">
    <text class="name">{{org.intro.name}}</text>
    <text class="short-name">{{org.intro.short_name}}</text>
    <text class="intro">创立于 {{org.intro.founded}} | 总部 {{org.intro.headquarters}}</text>
  </view>
  <view class="desc-card">
    <text class="desc-text">{{org.intro.description}}</text>
  </view>
  <!-- 领导班子 -->
  <view class="section" wx:if="{{org.leadership.length > 0}}">
    <view class="section-title">领导班子</view>
    <view class="leader-item" wx:for="{{org.leadership}}" wx:key="title">
      <text class="leader-title">{{item.title}}</text>
      <text class="leader-name">{{item.name}}</text>
    </view>
  </view>
  <!-- 支部列表 -->
  <view class="section" wx:if="{{org.branches.length > 0}}">
    <view class="section-title">下辖支部</view>
    <view class="branch-item" wx:for="{{org.branches}}" wx:key="id">
      <text class="branch-name">{{item.name}}</text>
      <text class="branch-count">{{item.member_count}}人</text>
    </view>
  </view>
</view>