.page { background: #f5f5f5; min-height: 100vh; }
.news-item { background: #fff; margin: 20rpx; border-radius: 12rpx; overflow: hidden; }
.n-cover { width: 100%; height: 360rpx; }
.n-info { padding: 24rpx; }
.n-title { font-size: 32rpx; font-weight: bold; color: #333; display: block; line-height: 1.4; }
.n-summary { font-size: 26rpx; color: #999; margin-top: 10rpx; display: block; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
.n-time { font-size: 22rpx; color: #ccc; margin-top: 10rpx; display: block; }
.empty { text-align: center; color: #999; font-size: 28rpx; padding: 80rpx 0; }
.load-more { text-align: center; color: #999; font-size: 26rpx; padding: 30rpx 0; }